{
  "id": "tasks",
  "name": "Tasks",
  "version": "1.0.0",
  "minAppVersion": "0.25.0",
  "permissions": ["ui.panel", "storage"],
  "author": "Aura",
  "icon": "kanban",
  "collections": {
    "tasks": {
      "fields": { "title": "string", "status": "string", "due": "date?", "note": "string?" }
    }
  },
  "actions": {
    "find_tasks": { "kind": "list", "collection": "tasks", "description": "Find tasks by text or status (todo, doing, done)" },
    "add_task": { "kind": "insert", "collection": "tasks", "description": "Add a task (status: todo, doing or done)" },
    "update_task": { "kind": "update", "collection": "tasks", "description": "Change a task, e.g. move it to done" },
    "remove_task": { "kind": "delete", "collection": "tasks", "description": "Delete a task" }
  },
  "provides": ["find_tasks", "add_task"]
}
